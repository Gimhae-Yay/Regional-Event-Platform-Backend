Authorization: Bearer {{platformAdminAccessToken}}
Accept: application/json

> {% client.test("환불 실패 목록 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "환불 실패 목록 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "환불 실패 목록 조회는 SUCCESS여야 합니다."); }); %}

### 13. 전체관리자 환불 실패 상세 조회
GET {{baseUrl}}/api/v1/platform-admin/refund-failures/{{refundFailureId}}
Authorization: Bearer {{platformAdminAccessToken}}
Accept: application/json

> {% client.test("환불 실패 상세 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "환불 실패 상세 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "환불 실패 상세 조회는 SUCCESS여야 합니다."); }); %}

### 14. 환불 실패 수동 처리
POST {{baseUrl}}/api/v1/platform-admin/refund-failures/{{refundFailureId}}/manual-actions
Authorization: Bearer {{platformAdminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "confirmedStatus": "SUCCEEDED",
  "reason": "외부 환불 상태를 확인했습니다.",
  "evidenceReference": "OPS-REFUND-FAILURE-{{$timestamp}}"
}

> {% client.test("환불 실패 수동 처리는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "환불 실패 수동 처리는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "환불 실패 수동 처리는 SUCCESS여야 합니다."); }); %}

### 15. 실패 환불 재시도
POST {{baseUrl}}/api/v1/platform-admin/refunds/{{refundId}}/retry
Authorization: Bearer {{platformAdminAccessToken}}
Accept: application/json

> {% client.test("환불 재시도는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "환불 재시도는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "환불 재시도는 SUCCESS여야 합니다."); }); %}
