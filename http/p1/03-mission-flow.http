GET {{baseUrl}}/api/v1/me/mission-participations/{{participationId}}
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

> {% client.test("내 미션 참여 상세 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "내 미션 참여 상세 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "내 미션 참여 상세 조회는 SUCCESS여야 합니다."); }); %}

### 16. 타인 미션 참여 상세 조회 - 403 FORBIDDEN 또는 404 NOT_FOUND 기대
GET {{baseUrl}}/api/v1/me/mission-participations/{{participationId}}
Authorization: Bearer {{otherVisitorAccessToken}}
Accept: application/json

> {% client.test("타인 미션 참여 상세 조회는 403 또는 404를 반환한다.", () => { client.assert([403, 404].includes(response.status), "타인 미션 참여 상세 조회는 403 또는 404여야 합니다."); }); %}

### 17. 완료 미션 보상 수령 - 201 CREATED 또는 기존 결과 기대
# participationId는 COMPLETED 상태인 별도 참여 ID를 사용합니다.
POST {{baseUrl}}/api/v1/me/mission-participations/{{participationId}}/rewards/claim
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

> {% client.test("완료 미션 보상 수령은 200 또는 201 SUCCESS를 반환한다.", () => { client.assert([200, 201].includes(response.status), "미션 보상 수령은 200 또는 201이어야 합니다."); client.assert(response.body.code === "SUCCESS", "미션 보상 수령은 SUCCESS여야 합니다."); }); %}

### 18. 미션 종료
POST {{baseUrl}}/api/v1/operator/missions/{{p1MissionFlowId}}/end
Authorization: Bearer {{operatorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "reasonCode": "OPERATOR_REQUEST"
}

> {% client.test("미션 종료는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "미션 종료는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "미션 종료는 SUCCESS여야 합니다."); }); %}
