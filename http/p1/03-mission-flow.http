@baseUrl = http://localhost:8080
@operatorAccessToken = {{p1OperatorAccessToken}}
@regionAdminAccessToken = {{p1RegionAdminAccessToken}}
@visitorAccessToken = {{p1VisitorAccessToken}}
@otherVisitorAccessToken = {{p1OtherVisitorAccessToken}}
@regionId = {{p1RegionId}}
@contentId = {{p1PublishedContentId}}
@rewardCouponPolicyId = {{p1PublishedMissionRewardCouponPolicyId}}
@publishedMissionId = {{p1PublishedMissionId}}
@participationId = {{p1MissionParticipationId}}

# P1 지역 미션 생성·심사·참여·보상 수령
# 선행 조건: rewardCouponPolicyId는 미션 보상용 공개 쿠폰 정책이고, participationId는 visitorAccessToken 소유여야 합니다.

### 1. 미션 생성 - 201 CREATED 기대
POST {{baseUrl}}/api/v1/operator/missions
Authorization: Bearer {{operatorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "P1 HTTP 방문 미션 {{$timestamp}}",
  "conditionType": "VISIT_COUNT",
  "requiredVisitCount": 1,
  "targetContentIds": [],
  "rewardCouponPolicyId": "{{rewardCouponPolicyId}}",
  "endsAt": "2027-12-31T23:59:59+09:00"
}

> {%
client.test("미션 생성은 201 SUCCESS와 식별자를 반환한다.", () => {
  client.assert(response.status === 201, "미션 생성은 201이어야 합니다.");
  client.assert(response.body.code === "SUCCESS", "미션 생성은 SUCCESS여야 합니다.");
  client.assert(response.body.data?.missionId, "미션 생성 응답에 missionId가 있어야 합니다.");
});
client.global.set("p1MissionFlowId", response.body.data.missionId);
%}

### 2. 운영자 미션 목록 조회
GET {{baseUrl}}/api/v1/operator/missions?status=DRAFT&page=0&size=20
Authorization: Bearer {{operatorAccessToken}}
Accept: application/json

> {% client.test("운영자 미션 목록 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "운영자 미션 목록 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "운영자 미션 목록 조회는 SUCCESS여야 합니다."); }); %}

### 3. 생성 미션 상세 조회
GET {{baseUrl}}/api/v1/operator/missions/{{p1MissionFlowId}}
Authorization: Bearer {{operatorAccessToken}}
Accept: application/json

> {% client.test("생성 미션 상세 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "미션 상세 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "미션 상세 조회는 SUCCESS여야 합니다."); }); %}

### 4. 생성 미션 수정
PATCH {{baseUrl}}/api/v1/operator/missions/{{p1MissionFlowId}}
Authorization: Bearer {{operatorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "P1 HTTP 방문 미션 수정 {{$timestamp}}",
  "conditionType": "VISIT_COUNT",
  "requiredVisitCount": 1,
  "targetContentIds": [],
  "rewardCouponPolicyId": "{{rewardCouponPolicyId}}",
  "endsAt": "2027-12-31T23:59:59+09:00"
}

> {% client.test("미션 수정은 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "미션 수정은 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "미션 수정은 SUCCESS여야 합니다."); }); %}

### 5. 지역 관리자 심사 제출
POST {{baseUrl}}/api/v1/operator/missions/{{p1MissionFlowId}}/submit
Authorization: Bearer {{operatorAccessToken}}
Accept: application/json

> {% client.test("미션 심사 제출은 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "미션 심사 제출은 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "미션 심사 제출은 SUCCESS여야 합니다."); }); %}

