GET {{baseUrl}}/api/v1/me/mission-participations?status=IN_PROGRESS&page=0&size=20
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

> {% client.test("내 미션 참여 목록 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "내 미션 참여 목록 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "내 미션 참여 목록 조회는 SUCCESS여야 합니다."); }); %}

