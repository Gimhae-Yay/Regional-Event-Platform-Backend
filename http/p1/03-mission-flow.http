GET {{baseUrl}}/api/v1/regions/{{regionId}}/missions?page=0&size=20
Accept: application/json

> {% client.test("공개 지역 미션 목록 조회는 200 SUCCESS를 반환한다.", () => { client.assert(response.status === 200, "공개 지역 미션 목록 조회는 200이어야 합니다."); client.assert(response.body.code === "SUCCESS", "공개 지역 미션 목록 조회는 SUCCESS여야 합니다."); }); %}

