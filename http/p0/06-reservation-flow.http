@baseUrl = http://localhost:8080
@visitorAccessToken = {{p0VisitorAccessToken}}
@otherVisitorAccessToken = {{p0OtherVisitorAccessToken}}
@sessionId = {{p0ScheduledSessionId}}
@soldOutSessionId = {{p0SoldOutSessionId}}
@startedSessionId = {{p0StartedSessionId}}
@expiredHoldId = {{p0ExpiredHoldId}}
@reservationId = {{p0ReservationId}}
@checkedInReservationId = {{p0CheckedInReservationId}}
@confirmIdempotencyKey = confirm-{{$uuid}}
@confirmConflictIdempotencyKey = confirm-conflict-{{$uuid}}

# P0 예약 홀드/확정/내 예약/취소
# 선행 조건: PUBLISHED 콘텐츠의 SCHEDULED 회차와 잔여 정원이 필요하다.

### 1. 공개 회차 정보 확인
GET {{baseUrl}}/api/v1/sessions/{{sessionId}}
Accept: application/json

### 2. 홀드 생성
POST {{baseUrl}}/api/v1/reservations
Authorization: Bearer {{visitorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "sessionId": "{{sessionId}}",
  "quantity": 1
}

> {%
client.test("예약 홀드 생성은 201 SUCCESS를 반환한다.", () => {
  client.assert(response.status === 201, "예약 홀드 생성은 201이어야 합니다.");
  client.assert(response.body.code === "SUCCESS", "예약 홀드 생성은 SUCCESS여야 합니다.");
  client.assert(response.body.data !== null, "예약 홀드 생성 응답에 data가 있어야 합니다.");
});
if (response.status === 201 && response.body.data !== null) {
  client.global.set("p0ReservationFlowHoldId", response.body.data.holdId);
}
%}

### 3. sessionId 형식 오류 - 400 INVALID_INPUT 기대
POST {{baseUrl}}/api/v1/reservations
Authorization: Bearer {{visitorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "sessionId": "not-number",
  "quantity": 1
}

### 4. quantity 0 - 400 INVALID_INPUT 기대
POST {{baseUrl}}/api/v1/reservations
Authorization: Bearer {{visitorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "sessionId": "{{sessionId}}",
  "quantity": 0
}

### 5. 정원 부족 - 409 RESERVATION_HOLD_CONFLICT 기대
POST {{baseUrl}}/api/v1/reservations
Authorization: Bearer {{visitorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "sessionId": "{{soldOutSessionId}}",
  "quantity": 1
}

### 6. 회차 시작 후 홀드 - 409 RESERVATION_HOLD_CONFLICT 기대
POST {{baseUrl}}/api/v1/reservations
Authorization: Bearer {{visitorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "sessionId": "{{startedSessionId}}",
  "quantity": 1
}

### 7. 예약 확정
POST {{baseUrl}}/api/v1/reservation-holds/{{p0ReservationFlowHoldId}}/confirm
Authorization: Bearer {{visitorAccessToken}}
Idempotency-Key: {{confirmIdempotencyKey}}
Accept: application/json

> {%
client.test("생성한 홀드의 예약 확정은 201 SUCCESS를 반환한다.", () => {
  client.assert(response.status === 201, "예약 확정은 201이어야 합니다.");
  client.assert(response.body.code === "SUCCESS", "예약 확정은 SUCCESS여야 합니다.");
  client.assert(response.body.data !== null, "예약 확정 응답에 data가 있어야 합니다.");
  client.assert(
    response.body.data.holdId === client.global.get("p0ReservationFlowHoldId"),
    "예약 확정 응답의 holdId는 생성한 홀드와 같아야 합니다."
  );
});
if (response.status === 201 && response.body.data !== null) {
  client.global.set("p0ReservationFlowReservationId", response.body.data.reservationId);
}
%}

### 8. 예약 확정 반복 - 같은 응답 기대
POST {{baseUrl}}/api/v1/reservation-holds/{{p0ReservationFlowHoldId}}/confirm
Authorization: Bearer {{visitorAccessToken}}
Idempotency-Key: {{confirmIdempotencyKey}}
Accept: application/json

> {%
client.test("같은 멱등 키의 예약 확정 재시도는 최초 성공 결과를 반환한다.", () => {
  client.assert(response.status === 201, "예약 확정 재시도는 201이어야 합니다.");
  client.assert(response.body.code === "SUCCESS", "예약 확정 재시도는 SUCCESS여야 합니다.");
  client.assert(
    response.body.data.reservationId === client.global.get("p0ReservationFlowReservationId"),
    "예약 확정 재시도는 최초 reservationId를 반환해야 합니다."
  );
});
%}

### 9. 같은 Idempotency-Key 다른 hold 요청 - 409 IDEMPOTENCY_KEY_CONFLICT 기대
POST {{baseUrl}}/api/v1/reservation-holds/{{expiredHoldId}}/confirm
Authorization: Bearer {{visitorAccessToken}}
Idempotency-Key: {{confirmIdempotencyKey}}
Accept: application/json

> {%
client.test("다른 홀드에 같은 멱등 키를 사용하면 409 IDEMPOTENCY_KEY_CONFLICT를 반환한다.", () => {
  client.assert(response.status === 409, "다른 홀드의 멱등 키 충돌은 409여야 합니다.");
  client.assert(
    response.body.code === "IDEMPOTENCY_KEY_CONFLICT",
    "다른 홀드의 멱등 키 충돌 코드는 IDEMPOTENCY_KEY_CONFLICT여야 합니다."
  );
});
%}

### 10. Idempotency-Key 누락 - 400 INVALID_INPUT 기대
POST {{baseUrl}}/api/v1/reservation-holds/{{p0ReservationFlowHoldId}}/confirm
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

> {%
client.test("Idempotency-Key가 없으면 400 INVALID_INPUT을 반환한다.", () => {
  client.assert(response.status === 400, "Idempotency-Key 누락은 400이어야 합니다.");
  client.assert(
    response.body.code === "INVALID_INPUT",
    "Idempotency-Key 누락 코드는 INVALID_INPUT이어야 합니다."
  );
});
%}

### 11. 만료 홀드 확정 - 409 RESERVATION_CONFIRM_CONFLICT 기대
POST {{baseUrl}}/api/v1/reservation-holds/{{expiredHoldId}}/confirm
Authorization: Bearer {{visitorAccessToken}}
Idempotency-Key: {{confirmConflictIdempotencyKey}}
Accept: application/json

> {%
client.test("만료 홀드 확정은 409 RESERVATION_CONFIRM_CONFLICT를 반환한다.", () => {
  client.assert(response.status === 409, "만료 홀드 확정은 409여야 합니다.");
  client.assert(
    response.body.code === "RESERVATION_CONFIRM_CONFLICT",
    "만료 홀드 확정 코드는 RESERVATION_CONFIRM_CONFLICT여야 합니다."
  );
});
%}

### 12. 내 예약 목록 조회
GET {{baseUrl}}/api/v1/me/reservations
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

### 13. 내 예약 상세 조회
GET {{baseUrl}}/api/v1/me/reservations/{{reservationId}}
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

### 14. 타인 예약 상세 조회 - 403 FORBIDDEN 기대
GET {{baseUrl}}/api/v1/me/reservations/{{reservationId}}
Authorization: Bearer {{otherVisitorAccessToken}}
Accept: application/json

### 15. 예약 취소
POST {{baseUrl}}/api/v1/me/reservations/{{reservationId}}/cancel
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

### 16. 예약 취소 반복 - 기존 취소 응답 기대
POST {{baseUrl}}/api/v1/me/reservations/{{reservationId}}/cancel
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

### 17. 체크인된 예약 취소 - 409 RESERVATION_CANCEL_CONFLICT 기대
POST {{baseUrl}}/api/v1/me/reservations/{{checkedInReservationId}}/cancel
Authorization: Bearer {{visitorAccessToken}}
Accept: application/json

