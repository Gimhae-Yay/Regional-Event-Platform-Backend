# SELECT visit_id, user_id, reservation_id FROM visit WHERE visit_id IN ({{visitId}}, {{otherVisitId}});
# SELECT review_id, visit_id, user_id, content_id, rating, status FROM review WHERE review_id IN ({{reviewId}}, {{otherReviewId}});
# SELECT audit_event_id, target_type, target_id, result, reason_code FROM audit_event WHERE target_type = 'REVIEW' ORDER BY audit_event_id DESC;
