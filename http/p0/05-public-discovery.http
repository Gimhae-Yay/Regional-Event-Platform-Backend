@baseUrl = http://localhost:8080
@regionId = 900001
@publishedContentId =
@scheduledSessionId =
@soldOutContentId =
@soldOutSessionId =

# P0 공개 탐색·지역 홈·회차·후기 조회
# 선행 조건:
# - regionId는 공개 region이어야 한다.
# - publishedContentId는 PUBLISHED 콘텐츠여야 한다.
# - scheduledSessionId와 soldOutSessionId는 공개 조회 가능한 회차여야 한다.

### 1. 지역 목록 조회
GET {{baseUrl}}/api/v1/regions
Accept: application/json

### 2. 공개 콘텐츠 목록 조회
GET {{baseUrl}}/api/v1/contents?regionId={{regionId}}
Accept: application/json

### 3. regionId 누락 - 400 INVALID_INPUT 기대
GET {{baseUrl}}/api/v1/contents
Accept: application/json

### 4. 잘못된 regionId - 400 INVALID_INPUT 또는 404 NOT_FOUND 기대
GET {{baseUrl}}/api/v1/contents?regionId=not-number
Accept: application/json

### 5. contentType 필터
GET {{baseUrl}}/api/v1/contents?regionId={{regionId}}&contentType=EVENT_EXPERIENCE
Accept: application/json

### 6. 잘못된 contentType - 400 INVALID_INPUT 기대
GET {{baseUrl}}/api/v1/contents?regionId={{regionId}}&contentType=UNKNOWN
Accept: application/json

### 7. 예약 가능 필터
GET {{baseUrl}}/api/v1/contents?regionId={{regionId}}&reservationAvailable=true
Accept: application/json

### 8. 잔여 정원 0 콘텐츠 예약 가능 필터 제외 확인
GET {{baseUrl}}/api/v1/contents?regionId={{regionId}}&reservationAvailable=true
Accept: application/json

### 9. 공개 콘텐츠 상세 조회
GET {{baseUrl}}/api/v1/contents/{{publishedContentId}}
Accept: application/json

### 10. 존재하지 않는 콘텐츠 - 404 NOT_FOUND 기대
GET {{baseUrl}}/api/v1/contents/999999999
Accept: application/json

### 11. 공개 회차 목록 조회
GET {{baseUrl}}/api/v1/contents/{{publishedContentId}}/sessions
Accept: application/json

### 12. 회차 예약 정보 조회
GET {{baseUrl}}/api/v1/sessions/{{scheduledSessionId}}
Accept: application/json

### 13. 존재하지 않는 회차 - 404 NOT_FOUND 기대
GET {{baseUrl}}/api/v1/sessions/999999999
Accept: application/json

### 14. 잔여 정원 0 회차 예약 가능 여부 확인
GET {{baseUrl}}/api/v1/sessions/{{soldOutSessionId}}
Accept: application/json

### 15. 지역 홈 조회
GET {{baseUrl}}/api/v1/regions/{{regionId}}/home
Accept: application/json

### 16. 존재하지 않는 지역 홈 조회 - 404 NOT_FOUND 기대
GET {{baseUrl}}/api/v1/regions/999999999/home
Accept: application/json

### 17. 공개 콘텐츠 후기 목록 조회
GET {{baseUrl}}/api/v1/contents/{{publishedContentId}}/reviews?page=0&size=20
Accept: application/json

### 18. 공개 콘텐츠 후기 목록 조회 - 잘못된 size, 400 INVALID_INPUT 기대
GET {{baseUrl}}/api/v1/contents/{{publishedContentId}}/reviews?page=0&size=0
Accept: application/json

# DB 확인
# SELECT region_id, name FROM region WHERE region_id = {{regionId}};
# SELECT content_id, region_id, status, representative_image_object_id FROM content WHERE content_id IN ({{publishedContentId}}, {{soldOutContentId}});
# SELECT session_id, content_id, status, capacity, remaining_capacity FROM content_session WHERE session_id IN ({{scheduledSessionId}}, {{soldOutSessionId}});
# SELECT image_object_id, lifecycle_status FROM image_object WHERE image_object_id = (SELECT representative_image_object_id FROM content WHERE content_id = {{publishedContentId}});
