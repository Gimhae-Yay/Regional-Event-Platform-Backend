@baseUrl = http://localhost:8080
@regionId = 900001
@otherRegionId = 900002
@operatorEmail = initial-operator-{{$timestamp}}@example.com
@operatorPassword = Test!23456
@operatorPhone = 01022223333
@regionAdminAccessToken =
@otherRegionAdminAccessToken =
@initialOperatorApplicationId =

# P0 운영자 최초 신청·심사
# 선행 조건:
# - regionId 담당 REGION_ADMIN access token을 regionAdminAccessToken에 설정한다.
# - 타 지역 권한 검증을 실행하려면 otherRegionAdminAccessToken에 다른 region의 REGION_ADMIN access token을 설정한다.
# - 최초 운영자 신청은 /api/v1/auth/signup에서 requestedRole=OPERATOR로 수행한다.

### 1. 최초 운영자 회원가입 신청 - 201 CREATED 기대
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json
Accept: application/json

{
  "email": "{{operatorEmail}}",
  "password": "{{operatorPassword}}",
  "name": "최초 신청 운영자",
  "phone": "{{operatorPhone}}",
  "requestedRole": "OPERATOR",
  "requestedRegionId": "{{regionId}}",
  "businessInformation": "김포 지역 체험 프로그램 운영 사업자 등록 정보"
}

> {%
client.global.set("initialOperatorUserId", response.body.data.userId);
%}

### 2. 최초 신청자 로그인 - 200 OK 기대
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{operatorEmail}}",
  "password": "{{operatorPassword}}"
}

> {%
const authorization = response.headers.valueOf("Authorization");
client.global.set("initialOperatorAccessToken", authorization.replace("Bearer ", ""));
%}

### 3. 승인 전 me 조회 - 200 OK, OPERATOR 권한 미부여 기대
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{initialOperatorAccessToken}}
Accept: application/json

### 4. 지역 관리자 대기 목록 조회 - 200 OK 기대
GET {{baseUrl}}/api/v1/region-admin/operator-requests?status=PENDING
Authorization: Bearer {{regionAdminAccessToken}}
Accept: application/json

> {%
const targetUserId = String(client.global.get("initialOperatorUserId"));
const operatorRequests = response.body.data.operatorRequests || [];
const target = operatorRequests.find((request) => String(request.applicantUserId) === targetUserId);
if (target) {
  client.global.set("initialOperatorApplicationId", target.operatorApplicationId);
}
%}

### 5. 지역 관리자 신청 상세 조회 - 200 OK 기대
GET {{baseUrl}}/api/v1/region-admin/operator-requests/{{initialOperatorApplicationId}}
Authorization: Bearer {{regionAdminAccessToken}}
Accept: application/json

### 6. 타 지역 관리자 신청 상세 조회 - 404 NOT_FOUND 기대
GET {{baseUrl}}/api/v1/region-admin/operator-requests/{{initialOperatorApplicationId}}
Authorization: Bearer {{otherRegionAdminAccessToken}}
Accept: application/json

### 7. 잘못된 신청 ID 상세 조회 - 400 INVALID_TYPE 기대
GET {{baseUrl}}/api/v1/region-admin/operator-requests/not-number
Authorization: Bearer {{regionAdminAccessToken}}
Accept: application/json

### 8. 운영자 신청 승인 - 200 OK 기대
POST {{baseUrl}}/api/v1/region-admin/operator-requests/{{initialOperatorApplicationId}}/approve
Authorization: Bearer {{regionAdminAccessToken}}
Accept: application/json

### 9. 운영자 신청 승인 반복 - 200 OK, 기존 승인 결과 기대
POST {{baseUrl}}/api/v1/region-admin/operator-requests/{{initialOperatorApplicationId}}/approve
Authorization: Bearer {{regionAdminAccessToken}}
Accept: application/json

### 10. 승인 후 me 조회 - 200 OK, OPERATOR 권한 부여 기대
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{initialOperatorAccessToken}}
Accept: application/json

### 11. 승인 후 반려 재처리 - 409 상태 충돌 기대
POST {{baseUrl}}/api/v1/region-admin/operator-requests/{{initialOperatorApplicationId}}/reject
Authorization: Bearer {{regionAdminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "rejectedReason": "이미 승인된 신청 반려 시도"
}

# DB 확인
# SELECT operator_application_id, applicant_user_id, requested_region_id, status, rejected_reason FROM operator_application WHERE operator_application_id = {{initialOperatorApplicationId}};
# SELECT user_id, role, region_id, revoked_at FROM user_role_assignment WHERE user_id = {{initialOperatorUserId}};
# SELECT audit_event_id, region_id, target_type, target_id, result, reason_code FROM audit_event WHERE target_id = {{initialOperatorApplicationId}} ORDER BY audit_event_id DESC;
