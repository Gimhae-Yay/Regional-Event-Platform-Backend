# SELECT audit_event_id, region_id, target_type, target_id, result, reason_code FROM audit_event WHERE target_id IN ({{pendingContentId}}, {{rejectContentId}}, {{publishedContentId}}, {{suspendContentId}}, {{deleteContentId}}, {{endContentId}}, {{notPublishedContentId}}, {{revisionId}}, {{rejectRevisionId}}, {{pendingSessionId}}, {{rejectSessionId}}, {{sessionRevisionId}}, {{rejectSessionRevisionId}}) ORDER BY audit_event_id DESC;
# 홀드/예약 종료 영향: SELECT status, COUNT(*) FROM capacity_hold WHERE content_session_id IN (SELECT session_id FROM content_session WHERE content_id = {{endContentId}}) GROUP BY status;
# 홀드/예약 종료 영향: SELECT status, COUNT(*) FROM reservation WHERE content_session_id IN (SELECT session_id FROM content_session WHERE content_id = {{endContentId}}) GROUP BY status;
