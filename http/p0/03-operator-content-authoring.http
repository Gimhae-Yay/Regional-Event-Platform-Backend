  "ageRequirement": "전체",
  "materials": "없음",
  "cancellationPolicyText": "회차 시작 전 취소",
  "publishAt": "{{publishAt}}",
  "representativeImageObjectId": "{{authoringImageObjectId}}",
  "sessions": [
    {
      "startsAt": "{{sessionEndsAt}}",
      "endsAt": "{{sessionStartsAt}}",
      "checkinOpenAt": "{{checkinOpenAt}}",
      "checkinCloseAt": "{{checkinCloseAt}}",
      "capacity": 20
    }
  ]
}

### 9. 콘텐츠 생성 - capacity 0, 400 INVALID_INPUT 기대
POST {{baseUrl}}/api/v1/operator/contents
Authorization: Bearer {{operatorAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "정원 오류 콘텐츠",
